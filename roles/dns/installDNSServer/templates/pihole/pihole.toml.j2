# /etc/pihole/pihole.toml -- pi-hole v6 FTL configuration (minimal override)
#
# Auto-generated by installDNSServer's configurePihole.yaml. Do NOT edit
# by hand -- changes will be overwritten on the next playbook run. Edit
# data/packages/pihole/metadata.yaml and re-run the playbook instead.
#
# Only keys present here override FTL's compiled defaults; everything
# else continues to use the default. Pi-hole v6 will keep these values
# across upgrades; it does NOT re-write user-set keys.
#
# Generated: {{ ansible_date_time.iso8601 }}

[dns]
# Forward every non-cached query to the co-located bind9. bind9
# answers the local zone(s) authoritatively and forwards everything
# else out to its own `forwarders:` list — one chain, one place to
# change resolvers. dnsUpstreams is derived at play time from
# data/packages/bind9/metadata.yaml (see installDNSServer's
# configurePihole.yaml) so drift between the two files is impossible by
# construction.
upstreams = [{% for u in dnsUpstreams | default([]) %}"{{ u }}"{% if not loop.last %}, {% endif %}{% endfor %}]

# Listen on port 53 only on the LAN interface's addresses. bind9 owns
# 127.0.0.2:53 (DDNS target for dhcpd) and starts first at boot. In the
# default LOCAL mode dnsmasq claims 0.0.0.0:53, which fails with
# "Address in use" and pi-hole answers no DNS at all. BIND limits it to
# this interface; except-interface=lo (in [misc]) stops dnsmasq adding
# loopback on its own, which would hit 127.0.0.2:53 again.
interface = "{{ piholeInterface | default('eth0') }}"
listeningMode = "BIND"

[webserver]
# Listen only on loopback so nginx is the sole public face. Nginx
# reverse-proxies /pihole/ -> http://127.0.0.1:8080/admin/.
port = "{{ ftlWebserverPort }}"

# Tell FTL its EXTERNAL URL prefix so redirects/absolute links it
# emits include "/pihole". nginx still proxies /pihole/ -> /admin/
# internally (strip-prefix), so this is metadata-only from FTL's POV.
# Without this, FTL emits "/admin/..." redirects which collide with
# webmin's reverse-proxy location.
paths.prefix = "/pihole"

[misc]
# See [dns] listeningMode above -- keep dnsmasq off loopback.
dnsmasq_lines = ["except-interface=lo"]
