; ============================================================================
; Reverse zone for {{ netInventory.network.cidr }} ({{ netInventory.dns.reverseOrigin }})
;
; Auto-generated by installDNSServer's configureBind9.yaml.
;
; This file is a DDNS-managed zone SKELETON — dhcpd writes PTR records
; here at lease time via TSIG-authenticated RFC 2136 updates. The only
; hand-authored entries below are for hosts with ddnsManaged: false
; in data/network/inventory.json.
;
; Do NOT edit by hand: this file is rewritten on every configure. Edit
; data/network/inventory.json instead, then re-run the playbook.
;
; Generated: {{ ansible_date_time.iso8601 }}
; ============================================================================
$TTL    1h
$ORIGIN {{ netInventory.dns.reverseOrigin }}.

@       IN SOA  {{ netInventory.dns.primaryNS }}.{{ netInventory.dns.domain }}. {{ netInventory.dns.adminContact | replace('@', '.') }}. (
                {{ ansible_date_time.epoch }}   ; serial (epoch)
                1h                              ; refresh
                15m                             ; retry
                1w                              ; expire
                1h                              ; minimum / negative TTL
)

@       IN NS   {{ netInventory.dns.primaryNS }}.{{ netInventory.dns.domain }}.

; ----------------------------------------------------------------------------
; Static PTR records — ddnsManaged: false. Host part is two octets
; ordered <last>.<third> because the zone origin is the /16
; (e.g. 168.192.in-addr.arpa). So 192.168.0.1 → "1.0", 192.168.2.16 → "16.2".
; ----------------------------------------------------------------------------
{% for h in netInventory.dns.staticRecords %}
{{ '%-7s' | format(h.ip.split('.')[3] + '.' + h.ip.split('.')[2]) }} IN PTR   {{ h.name }}.{{ netInventory.dns.domain }}.
{% endfor %}

; ----------------------------------------------------------------------------
; DDNS-managed PTRs appear below this line at runtime — dhcpd writes
; them as leases are issued. Do not add records manually.
; ----------------------------------------------------------------------------
