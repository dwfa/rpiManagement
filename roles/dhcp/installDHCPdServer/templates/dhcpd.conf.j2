#jinja2: trim_blocks:True, lstrip_blocks:True
##############################################################################
# /etc/dhcp/dhcpd.conf -- DHCP server configuration
#
# Auto-generated by installDHCPdServer's configureDHCPd.yaml from the
# canonical network inventory at data/network/inventory.json (schema v5).
#
# Do NOT edit by hand -- changes will be overwritten on the next
# playbook run. Edit data/network/inventory.json instead, then
# re-run the playbook.
#
# DDNS-managed hosts get their DNS records written by dhcpd itself
# at lease time via TSIG-authenticated RFC 2136 updates. Static-DNS
# hosts (dns, wormhole) are hand-authored in bind9's zone files.
#
# Generated: {{ ansible_date_time.iso8601 }}
##############################################################################

authoritative;

##############################################################################
# DDNS -- RFC 2136 dynamic DNS updates to bind9. TSIG key is shared
# with bind9 via data/ddns/tsig/<domain>.tsig.key.yaml; drift is
# impossible by construction. Zone declarations below map each
# domain / reverse-zone dhcpd cares about to the same TSIG key.
##############################################################################
ddns-update-style      interim;
ddns-updates           on;
update-static-leases   on;
update-conflict-detection false;

key "{{ tsigKey.name }}" {
    algorithm {{ tsigKey.algorithm }};
    secret "{{ tsigKey.secret }}";
}

zone {{ network.domain }}. {
    primary {{ ddnsPrimary }};
    key "{{ tsigKey.name }}";
}
{% for s in zoneSubnets %}
zone {{ s.reverseOrigin }}. {
    primary {{ ddnsPrimary }};
    key "{{ tsigKey.name }}";
}
{% endfor %}

##############################################################################
# Global options -- sent to every client
##############################################################################
option domain-name         "{{ network.domain }}";
option domain-search       "{{ network.domain }}";
option domain-name-servers {{ network.dnsServer }};
option routers             {{ network.gateway }};
option subnet-mask         {{ networkCidr | ansible.utils.ipaddr('netmask') }};

default-lease-time {{ defaultLeaseTime }};
max-lease-time     {{ maxLeaseTime }};

##############################################################################
# Subnet -- covers the entire /16. Reservations below cover known
# devices; the dynamic pools serve unknown clients (guests, etc.).
##############################################################################
subnet {{ networkSubnet }} netmask {{ networkCidr | ansible.utils.ipaddr('netmask') }} {
{% for pool in dhcpPools %}
    ##########################################################################
    # Pool: {{ pool.name }}{{ ' — ' ~ pool.description if pool.description else '' }}
    ##########################################################################
    pool {
        range              {{ pool.startIP }} {{ pool.endIP }};
        default-lease-time {{ pool.leaseTimeSecs }};
        max-lease-time     {{ pool.leaseTimeSecs }};
        allow              unknown-clients;
    }
{% endfor %}
}

##############################################################################
# Reservations -- one host block per MAC per dhcpManaged device, grouped
# by inventory group for readability. Hosts with dhcpManaged: false
# (e.g. dns, wormhole, ds9) are self-configured and not reserved here.
##############################################################################
{% for group in hostGroups %}
##############################################################################
# {{ group.name }}{{ ' — ' ~ group.description if group.description else '' }}
##############################################################################
{% for h in group.hosts | selectattr('dhcpManaged') | sort(attribute='ip') %}
{% set annotation = [h.hardware, h.comment] | select | join(' — ') %}
{% if annotation %}
# {{ annotation }}
{% endif %}
{% if h.wiredMAC %}
host {{ h.name }}-wired {
    hardware ethernet {{ h.wiredMAC }};
    fixed-address     {{ h.ip }};
    option host-name  "{{ h.name }}";
}
{% endif %}
{% if h.wirelessMAC %}
host {{ h.name }}-wireless {
    hardware ethernet {{ h.wirelessMAC }};
    fixed-address     {{ h.ip }};
    option host-name  "{{ h.name }}";
}
{% endif %}
{% endfor %}
{% endfor %}
