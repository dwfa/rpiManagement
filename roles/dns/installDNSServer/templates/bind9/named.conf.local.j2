// ===========================================================================
// Local zones served by this bind instance
//
// Auto-generated by installDNSServer's configureBind9.yaml. Do NOT edit
// by hand — changes will be overwritten on the next playbook run. Edit
// data/packages/bind9/metadata.yaml or the network inventory
// instead.
//
// allow-update on every zone references the TSIG key defined in
// named.conf.options. Only isc-dhcp-server (with matching key) can
// write DDNS updates; every other source is refused.
//
// Generated: {{ ansible_date_time.iso8601 }}
// ===========================================================================

// ---------------------------------------------------------------------------
// Forward zone
// ---------------------------------------------------------------------------
zone "{{ netInventory.dns.domain }}" {
    type master;
    file "{{ forwardZoneFile }}";
    allow-update { key "{{ tsigKey.name }}"; };
};

// ---------------------------------------------------------------------------
// Reverse zone
// ---------------------------------------------------------------------------
zone "{{ netInventory.dns.reverseOrigin }}" {
    type master;
    file "{{ reverseZoneFile }}";
    allow-update { key "{{ tsigKey.name }}"; };
};
