#jinja2: trim_blocks:True, lstrip_blocks:True
##############################################################################
# /etc/dhcp/dhcpd.conf -- DHCP server configuration
#
# Auto-generated by installDHCPdServer's configureDHCPd.yaml from the
# network inventory (netInventory, built by parseInventory.yaml).
#
# Do NOT edit by hand -- changes will be overwritten on the next
# playbook run. Edit data/network/inventory.json instead, then
# re-run the playbook.
#
# DDNS-managed hosts get their DNS records written by dhcpd itself
# at lease time via TSIG-authenticated RFC 2136 updates. Static-DNS
# hosts (dns, wormhole) are hand-authored in bind9's zone files.
#
# Generated: {{ ansible_date_time.iso8601 }}
##############################################################################

authoritative;

##############################################################################
# DDNS -- RFC 2136 dynamic DNS updates to bind9. TSIG key is shared
# with bind9 via data/ddns/tsig/<domain>.tsig.key.yaml; drift is
# impossible by construction. Zone declarations below map the
# forward and reverse zones to the same TSIG key.
##############################################################################
ddns-update-style      interim;
ddns-updates           on;
update-static-leases   on;
update-conflict-detection false;

key "{{ tsigKey.name }}" {
    algorithm {{ tsigKey.algorithm }};
    secret "{{ tsigKey.secret }}";
}

zone {{ netInventory.dns.domain }}. {
    primary {{ netInventory.dns.ddns.host }};
    key "{{ tsigKey.name }}";
}

zone {{ netInventory.dns.reverseOrigin }}. {
    primary {{ netInventory.dns.ddns.host }};
    key "{{ tsigKey.name }}";
}

##############################################################################
# Global options -- sent to every client
##############################################################################
option domain-name         "{{ netInventory.dns.domain }}";
option domain-search       "{{ netInventory.dns.domain }}";
option domain-name-servers {{ netInventory.dns.server }};
option routers             {{ netInventory.network.gateway }};
option subnet-mask         {{ netInventory.network.netmask }};

default-lease-time {{ netInventory.dhcp.defaultLeaseTimeSecs }};
max-lease-time     {{ netInventory.dhcp.maxLeaseTimeSecs }};

##############################################################################
# Subnet -- covers {{ netInventory.network.cidr }}. Reservations below cover
# known devices; the dynamic pools serve unknown clients (guests, etc.).
##############################################################################
subnet {{ netInventory.network.networkAddress }} netmask {{ netInventory.network.netmask }} {
{% for pool in netInventory.dhcp.pools %}
    pool {
        range              {{ pool.startIP }} {{ pool.endIP }};
        default-lease-time {{ pool.leaseTimeSecs }};
        max-lease-time     {{ pool.leaseTimeSecs }};
        allow              unknown-clients;
    }
{% endfor %}
}

##############################################################################
# Reservations -- one host block per MAC per reserved device, in
# inventory order. ddns-hostname registers the inventory name in DNS,
# whatever name the device announces; option host-name tells the device
# that name. Hosts with dhcpManaged: false (e.g. dns, wormhole) are
# self-configured and not reserved here.
##############################################################################
{% for h in netInventory.dhcp.reservations %}
{% if h.wiredMAC %}
host {{ h.name }}-wired {
    hardware ethernet {{ h.wiredMAC }};
    fixed-address     {{ h.ip }};
    option host-name  "{{ h.name }}";
    ddns-hostname     "{{ h.name }}";
}
{% endif %}
{% if h.wirelessMAC %}
host {{ h.name }}-wireless {
    hardware ethernet {{ h.wirelessMAC }};
    fixed-address     {{ h.ip }};
    option host-name  "{{ h.name }}";
    ddns-hostname     "{{ h.name }}";
}
{% endif %}
{% endfor %}
