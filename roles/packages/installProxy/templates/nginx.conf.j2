###############################################################################
# nginx main configuration file
#
# Author: Acheson, Douglas WF (dwfa@dwfa.ca)
#
# Copyright 2023 Douglas WF Acheson (dwfa@dwfa.ca)
# Licensed under Apache License 2.0. See LICENSE.md for details.
#
# Version: 2.0
# Date: September 25, 2026
#
# Rendered by roles/packages/installProxy. The worker user comes from
# proxyUser (see the role's defaults).
#
# This config file structure contains a root (known as main) and a collection
# of contexts
# main
#    |
#    |-- events (a context)
#    |
#    |-- http (a context)
#    |
#    |-- stream (a context)
#
# Reference: https://nginx.org/en/docs/dirindex.html <-- directives
#
# Before the contexts elements this config file defines
#   uid to run under
#   defines # of threads
#   default logging configuration
#   pid file location
#   loading of modules
###############################################################################

###############################################################################
# Define what uid to run under
###############################################################################
user {{ proxyUser }};

###############################################################################
# Define the # of processes to have
#   auto --> sets to # of CPU cores
###############################################################################
worker_processes auto;

###############################################################################
# Where to store the PID file
###############################################################################
pid /run/nginx.pid;

###############################################################################
# Define how default error logging configuration
###############################################################################
error_log /var/log/nginx/error.log;

###############################################################################
# Include the desired modules
###############################################################################
include /etc/nginx/modules-enabled/*.conf;

###############################################################################
# The "events" context
# --------------------
# Defines how inbound connections (request) behave
#   worker_connections <-- # of connections per worker (process)
###############################################################################
events
{
  worker_connections 512;
}

###############################################################################
# The "http" context
# --------------------
#
#
###############################################################################
http
{
  sendfile on ;
  tcp_nopush on ;
  types_hash_max_size 2048 ;

  include /etc/nginx/mime.types ;
  default_type application/octet-stream ;

  #############################################################################
  # Detect IP-based access. Used by 00-default.conf's port 80 server
  # block to return a friendly "use a hostname" page rather than
  # 301-redirecting to an HTTPS URL whose cert won't match the IP.
  # Matches bare IPv4, and IPv6 with or without brackets.
  #############################################################################
  map $host $isIP
  {
    default                  0 ;
    "~^[0-9.]+$"             1 ;
    "~^\[?[0-9a-fA-F:]+\]?$" 1 ;
  }

  #############################################################################
  # gzip compression — only kicks in for the listed MIME types and for
  # responses >= gzip_min_length. comp_level 5 is the usual sweet spot
  # (diminishing returns past 6, CPU climbs fast).
  #############################################################################
  gzip on ;
  gzip_vary on ;
  gzip_proxied any ;
  gzip_comp_level 5 ;
  gzip_min_length 1024 ;
  gzip_types text/plain
             text/css
             text/xml
             text/javascript
             application/json
             application/javascript
             application/xml
             application/xml+rss
             image/svg+xml ;

  #############################################################################
  # TLS configuration (Mozilla "intermediate" profile, May 2026)
  # - TLS 1.0/1.1 deprecated (BEAST etc.); SSLv3 dropped (POODLE)
  # - ssl_protocols is an allow-list (not preference); OpenSSL always
  #   negotiates the highest mutually-supported version regardless of
  #   token order
  # - cipher list aligns with Mozilla's intermediate guidance — broad
  #   client compatibility, no known-broken suites
  # - session_tickets off forces fresh handshakes (small perf hit, big
  #   forward-secrecy win when only a handful of clients connect)
  #############################################################################
  ssl_protocols              TLSv1.3 TLSv1.2 ;
  ssl_prefer_server_ciphers  off ;
  ssl_ciphers                ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384 ;
  ssl_session_cache          shared:SSL:10m ;
  ssl_session_timeout        1d ;
  ssl_session_tickets        off ;

  server_tokens off; # don't expose nginx version in Server: headers / error pages ;

  client_max_body_size 32m; # max request body — covers webmin module/backup uploads, gravity lists ;

  log_format longFormat '[$remote_addr] @ [$time_local] requested [$request]'
                        ' sent [$body_bytes_sent] byte with status [$status]' ;

  include /etc/nginx/sites-enabled/*.conf ;
}