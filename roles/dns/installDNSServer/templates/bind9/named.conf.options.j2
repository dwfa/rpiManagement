// ===========================================================================
// bind daemon-level options
//
// Auto-generated by installDNSServer's configureBind9.yaml from
// data/packages/bind9/metadata.yaml and the network inventory.
// Do NOT edit by hand.
//
// Generated: {{ ansible_date_time.iso8601 }}
// ===========================================================================

// ---------------------------------------------------------------------------
// LAN ACL — query + recursion gate. Sourced from bind9/metadata.yaml
// lanCIDRs list.
// ---------------------------------------------------------------------------
acl "lan" {
{% for net in lanCIDRs %}
    {{ net }};
{% endfor %}
};

// ---------------------------------------------------------------------------
// TSIG key — shared with isc-dhcp-server so it can authenticate DDNS
// updates. Key material lives at:
//   {{ tsigKeyPath }}
// Both daemons load the same YAML; drift is impossible by construction.
// ---------------------------------------------------------------------------
key "{{ tsigKey.name }}" {
    algorithm {{ tsigKey.algorithm }};
    secret "{{ tsigKey.secret }}";
};

options {
    directory "/var/cache/bind";

    // -----------------------------------------------------------------------
    // Listen — one block per (port, addresses) tuple.
    // -----------------------------------------------------------------------
{% for entry in listenIPv4 %}
    listen-on port {{ entry.port }} {
{% for ip in entry.addresses %}
        {{ ip }};
{% endfor %}
    };
{% endfor %}
    listen-on-v6 {
{% for ip in listenIPv6 %}
        {{ ip }};
{% endfor %}
    };

    // -----------------------------------------------------------------------
    // Access control
    // -----------------------------------------------------------------------
    allow-query     { lan; };
    allow-recursion { lan; };

    // -----------------------------------------------------------------------
    // Forwarders for non-local queries
    // -----------------------------------------------------------------------
    forwarders {
{% for fwd in netInventory.dns.forwarders %}
        {{ fwd }};
{% endfor %}
    };
    forward only;

    // -----------------------------------------------------------------------
    // DNSSEC
    // -----------------------------------------------------------------------
    dnssec-validation {{ netInventory.dns.dnssecValidation }};

    // -----------------------------------------------------------------------
    // Misc hardening
    // -----------------------------------------------------------------------
    version             "not disclosed";
    auth-nxdomain       no;          // conform to RFC1035
    minimal-responses   yes;
};
