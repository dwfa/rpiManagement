##############################################################################
# /etc/pihole/setupVars.conf -- Pi-hole configuration
#
# Auto-generated by installDNSServer's configurePihole.yaml. Do NOT edit
# by hand -- changes will be overwritten on the next playbook run. Edit
# data/packages/pihole/metadata.yaml and re-run the playbook instead.
#
# Generated: {{ ansible_date_time.iso8601 }}
##############################################################################

##############################################################################
# Upstream DNS -- bind9 on localhost. Bind listens on 127.0.0.1:5335
# (data/packages/bind9/metadata.yaml). Pi-hole forwards every query
# to bind; bind serves the local zone and recurses to public
# resolvers for everything else.
##############################################################################
PIHOLE_DNS_1=127.0.0.1#5335
DNS_FQDN_REQUIRED=true
DNS_BOGUS_PRIV=true
DNSSEC=false
REV_SERVER=false

##############################################################################
# DHCP -- explicitly disabled. isc-dhcp-server owns DHCP on this host.
##############################################################################
DHCP_ACTIVE=false

##############################################################################
# Web server -- pi-hole's installer is told NOT to deploy lighttpd
# (INSTALL_WEB_SERVER=false at install time). nginx fronts the admin
# UI via /pihole/ on the wildcard HTTPS vhost.
##############################################################################
LIGHTTPD_ENABLED=false
INSTALL_WEB_SERVER=false
INSTALL_WEB_INTERFACE=true
WEBUIBOXEDLAYOUT=traditional
WEBTHEME=default-light

##############################################################################
# Listening interface -- single = listen only on PIHOLE_INTERFACE.
# Bind is loopback-only so pi-hole is the LAN-facing DNS entry point.
##############################################################################
PIHOLE_INTERFACE={{ piholeInterface | default('eth0') }}
DNSMASQ_LISTENING=single
IPV6_ADDRESS=

##############################################################################
# Logging + blocking
##############################################################################
QUERY_LOGGING=true
BLOCKING_ENABLED=true