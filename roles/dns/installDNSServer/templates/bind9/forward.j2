; ============================================================================
; Forward zone for {{ domain }}
;
; Auto-generated by installDNSServer's configureBind9.yaml.
;
; This file is a DDNS-managed zone SKELETON — dhcpd writes A records
; here at lease time via TSIG-authenticated RFC 2136 updates. The only
; hand-authored entries below are for hosts with ddnsManaged: false
; in data/network/inventory.json (typically the DNS server itself and
; the router — hosts that must resolve when DHCP is down).
;
; Do NOT edit by hand: this file is rewritten on every configure. Edit
; data/network/inventory.json instead, then re-run the playbook.
;
; Generated: {{ ansible_date_time.iso8601 }}
; ============================================================================
$TTL    1h
$ORIGIN {{ domain }}.

@       IN SOA  {{ primaryNS }}.{{ domain }}. {{ adminContact | replace('@', '.') }}. (
                {{ ansible_date_time.epoch }}   ; serial (epoch)
                1h                              ; refresh
                15m                             ; retry
                1w                              ; expire
                1h                              ; minimum / negative TTL
)

@       IN NS   {{ primaryNS }}.{{ domain }}.

; ----------------------------------------------------------------------------
; Static hosts — ddnsManaged: false. Hand-authored; dhcpd cannot rewrite.
; ----------------------------------------------------------------------------
{% for h in staticHosts | selectattr('name') | sort(attribute='ip') %}
{{ '%-20s' | format(h.name) }} IN A     {{ h.ip }}
{% endfor %}

; ----------------------------------------------------------------------------
; DDNS-managed hosts appear below this line at runtime — dhcpd writes
; A records here as leases are issued. Do not add records manually.
; ----------------------------------------------------------------------------
