# Path to dhcpd's config file (default is /etc/dhcp/dhcpd.conf)
#DHCPDv4_CONF=/etc/dhcp/dhcpd.conf
#DHCPDv6_CONF=/etc/dhcp/dhcpd6.conf

# Path to dhcpd's PID file (default is /run/dhcp-server/dhcpd.pid)
#DHCPDv4_PID=/run/dhcp-server/dhcpd.pid
#DHCPDv6_PID=/run/dhcp-server/dhcpd6.pid

# Additional options to start dhcpd with
#OPTIONS=""

# Network interfaces dhcpd should listen on. Leave INTERFACESv6 empty
# until we explicitly support IPv6.
INTERFACESv4="{{ listenInterface }}"
INTERFACESv6=""