##############################################################################
# Ansible Inventory Template
#
# This is an example inventory file for the Ansible RPi management framework.
# Copy this to data/inventory.yaml and customize for your environment.
#
# INSTRUCTIONS:
# 1. Copy: cp inventory.yaml.example data/inventory.yaml
# 2. Replace example hosts with your actual Raspberry Pi addresses
# 3. Organize hosts into groups based on their roles
# 4. Update the local control machine settings
##############################################################################
---

# Web servers or public-facing services
webservers:
  hosts:
    rpi-web1:
      ansible_host: 10.0.1.10
    rpi-web2:
      ansible_host: 10.0.1.11

# Database or data storage hosts
databases:
  hosts:
    rpi-db1:
      ansible_host: 10.0.1.20

# DNS and network infrastructure
infrastructure:
  hosts:
    rpi-dns1:
      ansible_host: 10.0.1.30

# Development or staging environment
staging:
  hosts:
    rpi-staging1:
      ansible_host: 10.0.2.10

# Production environment
production:
  hosts:
    rpi-prod1:
      ansible_host: 10.0.1.40
    rpi-prod2:
      ansible_host: 10.0.1.41

# Image preparation and installation host
installer:
  hosts:
    rpi-installer:
      ansible_host: 10.0.3.1

# Local control machine (runs Ansible commands)
# This is typically your macOS or Linux workstation
localhost:
  hosts:
    control:
      ansible_connection: local
      ansible_python_interpreter: /usr/bin/python3
